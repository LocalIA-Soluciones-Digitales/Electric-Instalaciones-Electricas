NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Opcional: notificación interna por email de cada aviso/presupuesto (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Opcional: verificación humana (Cloudflare Turnstile) en /api/lead.
# Mientras no se configuren, el endpoint sigue protegido por rate limiting,
# comprobación de origen y honeypot, pero sin CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: Upstash Redis (capa gratuita en https://upstash.com), usado por
# /api/lead para dos cosas independientes:
# 1. Rate limiting distribuido entre instancias serverless (sin esto, el
#    límite es en memoria y por instancia, válido en desarrollo pero no a
#    escala en producción).
# 2. Archivo de respaldo de cada aviso/presupuesto, para que quede un
#    registro aunque el email interno (Resend) falle o no esté configurado.
# Mientras no se configuren, ambas funciones se degradan de forma segura:
# el rate limit sigue funcionando en memoria y el archivo simplemente no se
# escribe (el aviso sigue llegando por WhatsApp y, si procede, por email).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: alerta de errores de /api/lead (p. ej. si Resend empieza a
# fallar). Acepta una URL de webhook entrante de Slack o Discord tal cual
# (POST con { text: "..." }); sin esta variable, los fallos solo quedan en
# los logs de Vercel, como hasta ahora.
LEAD_ALERT_WEBHOOK_URL=
